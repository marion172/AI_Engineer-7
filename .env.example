# ==============================================================================
# Variables de Entorno - API de Produccion y Monitoreo Activo
# ==============================================================================

# 1. Configuracion de Redis
REDIS_URL=redis://localhost:6379/0

# 2. Configuracion de LLM (OpenRouter - NVIDIA Nemotron)
OPENAI_API_KEY=openrouter_api_key
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=nvidia/nemotron-3.5-lightning:free

# 3. Observabilidad: LangSmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=langsmith_api_key
LANGCHAIN_PROJECT=multiagente-api
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# 4. Herramientas Opcionales
TAVILY_API_KEY=
